    "box": {
     "id": "obj-9",
     "maxclass": "v8.codebox",
     "patching_rect": [
      20,
      158,
      600,
      548
     ],
     "code": "inlets = 1;\noutlets = 1;\n\nconst { Phonon } = require(\"Phonon\");\n\n// send every note as \"pitch velocity durationMs delayMs\" to [pipe 0 0 0 0]\nfunction play(events) {\n    for (const e of events) {\n        outlet(0, e.pitch, e.velocity, Math.round(e.durationSec * 1000), Math.round(e.startSec * 1000));\n    }\n}\n\nfunction bang() {\n    // start 0 s, 1 s long, middle C, mezzoforte\n    const note = new Phonon(0, 1, 60, \"mf\");\n    play(note.toEvents());\n}\n\nfunction seq() {\n    // three pitches one after another, sharing 1.5 s\n    const note = new Phonon(0, 1.5, [60, 64, 67], \"mp\");\n    play(note.toEvents());\n}\n\nfunction chord() {\n    // the same pitches at once, as note names\n    const note = new Phonon(0, 2, [\"c4\", \"e4\", \"g4\"], \"pp\", 60, { chordOrSeq: \"chord\" });\n    play(note.toEvents());\n}\n\nfunction print() {\n    const note = new Phonon(0, 1.5, [60, 64, 67], \"mp\");\n    post(note.toString(), \"\\n\");\n    for (const e of note.toEvents()) {\n        post(JSON.stringify(e), \"\\n\");\n    }\n}\n",
     "filename": "none",
     "text": "",
     "numinlets": 1,
     "numoutlets": 1,
     "outlettype": [
      ""
     ],
     "fontname": "Menlo",
     "fontsize": 11.0
    }
